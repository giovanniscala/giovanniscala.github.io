[{"authors":null,"categories":null,"content":"I am a theoretical physicist working at the interface of quantum information, quantum communication, quantum foundations, mathematical physics, and quantum optics. My research develops practical ways to certify and protect quantum resources under realistic constraints, including finite data, noise, loss, imperfect devices, and restricted measurement access.\nCurrent themes include finite-size security in quantum key distribution, device-independent methods and self-testing, entanglement detection through randomized measurements, quantum error filtration, Bell nonlocality, and quantum machine learning. Earlier work spans positive maps and entanglement witnesses, light-matter interaction, and correlation plenoptic imaging.\nFrom November 2026, I will join Nicolaus Copernicus University in Toruń as an Assistant Professor and Principal Investigator of the NCN SONATA 21 project Dynamical Resource for Multipartite Quantum Systems (grant 2025/59/D/ST2/02708; November 2026–October 2029).\n  Download my CV (updated September 2026).\n","date":1787702400,"expirydate":-62135596800,"kind":"term","lang":"en","lastmod":1789689600,"objectID":"2525497d367e79493fd32b198b28f040","permalink":"","publishdate":"0001-01-01T00:00:00Z","relpermalink":"","section":"authors","summary":"I am a theoretical physicist working at the interface of quantum information, quantum communication, quantum foundations, mathematical physics, and quantum optics. My research develops practical ways to certify and protect quantum resources under realistic constraints, including finite data, noise, loss, imperfect devices, and restricted measurement access.","tags":null,"title":"Giovanni Scala","type":"authors"},{"authors":null,"categories":null,"content":"How can entanglement be certified without reconstructing a complete quantum state? This research combines mathematical criteria based on positive maps and invariants with experimentally accessible randomized measurements. The aim is to obtain rigorous guarantees that remain useful with finite data, noise, and restricted measurement access.\n","date":1789689600,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789689600,"objectID":"7972d616d2785ef2ecf9057720e353a6","permalink":"https://giovanniscala.github.io/project/entanglement-certification/","publishdate":"2026-09-18T00:00:00Z","relpermalink":"/project/entanglement-certification/","section":"project","summary":"Positive maps, local invariants, and experimentally accessible randomized-measurement tests for detecting multipartite and high-dimensional entanglement.","tags":["Entanglement","Randomized measurements","Positive maps"],"title":"Entanglement Certification","type":"project"},{"authors":null,"categories":null,"content":"This theme studies how security guarantees change when quantum communication protocols use finite data, imperfect devices, and realistic noise models. It includes device-independent QKD, finite-size proof techniques, and discrete- and continuous-variable protocols.\n","date":1789689600,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789689600,"objectID":"bde31f1cff6b089e8fc872de63d55f05","permalink":"https://giovanniscala.github.io/project/secure-quantum-communication/","publishdate":"2026-09-18T00:00:00Z","relpermalink":"/project/secure-quantum-communication/","section":"project","summary":"Finite-size security, device-independent quantum key distribution, and discrete- and continuous-variable protocols under realistic constraints.","tags":["Quantum key distribution","Device independence","Finite-size security"],"title":"Secure Quantum Communication","type":"project"},{"authors":null,"categories":null,"content":"Bell inequalities and contextuality provide operational tests of nonclassical behaviour. This work develops such tests into practical certification tools, including self-testing protocols that identify quantum states and measurements from observed correlations.\n","date":1789603200,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789603200,"objectID":"9363916313572bccdd227c1926b6c241","permalink":"https://giovanniscala.github.io/project/quantum-foundations-self-testing/","publishdate":"2026-09-17T00:00:00Z","relpermalink":"/project/quantum-foundations-self-testing/","section":"project","summary":"Bell nonlocality, contextuality, operational nonclassicality, and certification with limited trust in devices.","tags":["Bell nonlocality","Contextuality","Self-testing"],"title":"Quantum Foundations and Self-Testing","type":"project"},{"authors":null,"categories":null,"content":"Quantum information is fragile. This research develops probabilistic and resource-aware methods that filter or mitigate errors while retaining useful quantum information for communication, computation, and sensing.\n","date":1789516800,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789516800,"objectID":"c1065c984102d210b2b43af35a4260db","permalink":"https://giovanniscala.github.io/project/quantum-information-protection/","publishdate":"2026-09-16T00:00:00Z","relpermalink":"/project/quantum-information-protection/","section":"project","summary":"Error filtration, noise robustness, and resource-aware protocols for quantum information processing and sensing.","tags":["Error filtration","Error mitigation","Quantum technologies"],"title":"Protection of Quantum Information","type":"project"},{"authors":null,"categories":null,"content":"This line of work studies how correlations in light improve imaging and sensing, and how the spatial structure of quantum emitters changes their interaction with electromagnetic environments.\n","date":1789430400,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789430400,"objectID":"10070ac8da7a4c6627dd62c8477ac97e","permalink":"https://giovanniscala.github.io/project/quantum-optics-imaging/","publishdate":"2026-09-15T00:00:00Z","relpermalink":"/project/quantum-optics-imaging/","section":"project","summary":"Correlation plenoptic imaging, second-order interference, turbulence, and spatially extended light-matter interaction.","tags":["Quantum optics","Imaging","Light-matter interaction"],"title":"Quantum Optics and Imaging","type":"project"},{"authors":null,"categories":null,"content":"This research investigates when quantum-data kernels remain informative with finite measurement budgets, with emphasis on resource scaling, concentration effects, and quantum phase-transition learning.\n","date":1789344e3,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1789344e3,"objectID":"7fffd72955c361aa5cae6c633fbc4230","permalink":"https://giovanniscala.github.io/project/quantum-machine-learning/","publishdate":"2026-09-14T00:00:00Z","relpermalink":"/project/quantum-machine-learning/","section":"project","summary":"Fidelity kernels, kernel concentration, finite-shot resource scaling, and learning quantum phase transitions.","tags":["Quantum machine learning","Fidelity kernels","Quantum phase transitions"],"title":"Quantum Machine Learning","type":"project"},{"authors":["Giovanni Scala","Cosmo Lupo"],"categories":null,"content":"","date":1787702400,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1787702400,"objectID":"ed8f1d2385be9d27f821d49a4f64cf38","permalink":"https://giovanniscala.github.io/publication/2026/recovery-free-chsh-particle-loss/","publishdate":"2026-08-26T00:00:00Z","relpermalink":"/publication/2026/recovery-free-chsh-particle-loss/","section":"publication","summary":"","tags":["Bell nonlocality","Particle loss","CHSH"],"title":"Recovery-Free CHSH Nonlocality with Particle Loss","type":"publication"},{"authors":["Gabriele Staffieri","Giovanni Scala","Cosmo Lupo"],"categories":null,"content":"","date":1782691200,"expirydate":-62135596800,"kind":"page","lang":"en","lastmod":1782691200,"objectID":"6e8e6909090fe24853cde04bbb60f2d6","permalink":"https://giovanniscala.github.io/publication/2026/finite-size-security-qkd/","pub